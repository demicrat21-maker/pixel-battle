{
  "rules": {
    ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
    ".write": "auth != null && root.child('admins/' + auth.uid).val() === true",

    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "config": {
      ".read": true,
      "cooldown": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000" },
      "locked": { ".validate": "newData.isBoolean()" },
      "announcement": { ".validate": "newData.isString() && newData.val().length <= 200" },
      "$other": { ".validate": false }
    },

    "board": {
      ".read": true,
      ".indexOn": ["u"],
      "$cell": {
        ".write": "auth != null && !root.child('banned/' + auth.uid).exists() && root.child('config/locked').val() !== true && newData.parent().parent().child('users/' + auth.uid + '/last').val() === now",
        ".validate": "$cell.matches(/^(1[0-9][0-9]|[1-9][0-9]|[0-9])_([1-9][0-9]|[0-9])$/) && newData.hasChildren(['c', 'u', 't'])",
        "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0" },
        "u": { ".validate": "newData.val() === auth.uid" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "last": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === now && (!data.exists() || data.val() + (root.child('config/cooldown').isNumber() ? root.child('config/cooldown').val() : 5000) <= now)"
        },
        "name": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "$other": { ".validate": false }
      }
    },

    "banned": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['at', 'by'])"
      }
    },

    "online": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === true"
      }
    }
  }
}
